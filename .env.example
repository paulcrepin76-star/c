# Copy to .env and adjust. Never put live supplier passwords in git.
# On Unraid, keep this file next to compose.yml in /mnt/user/appdata/resto/
# Deploy from a LAN laptop: ./scripts/deploy-unraid.sh root@YOUR_UNRAID_IP

TZ=America/New_York
PUID=99
PGID=100

# Host path for all container config/data (Unraid default below).
APPDATA=/mnt/user/appdata/resto
# Drop folder for PDFs you download yourself. Paperless watches this.
CONSUME_DIR=/mnt/user/documents/invoices-inbox

POSTGRES_USER=resto
POSTGRES_PASSWORD=change-me-now
POSTGRES_DB=resto

# Used by resto-core sessions + n8n. Generate with: openssl rand -hex 32
SECRET_KEY=change-me-generate-a-long-random-string
N8N_ENCRYPTION_KEY=change-me-generate-a-long-random-string
PAPERLESS_SECRET_KEY=change-me-generate-a-long-random-string

# Public URLs if you put the stack behind Nginx Proxy Manager / Caddy.
# Leave as LAN URLs if you only access it on your home network.
RESTO_URL=http://192.168.1.10:8088
PAPERLESS_URL=http://192.168.1.10:8011
MEALIE_URL=http://192.168.1.10:9925
N8N_URL=http://192.168.1.10:5678
METABASE_URL=http://192.168.1.10:3001

# Optional: resto-core talks to these if set. Credentials stay here or on /connect, never in code.
RESTO_API_KEY=change-me-api-key
OPEN_PRICES_ENABLED=true
BLS_ENABLED=true
USDA_MMN_API_KEY=
HOME_LAT=26.3398
HOME_LON=-81.7787
HOME_MARKET=Bonita Springs, Florida
MEALIE_BASE_URL=http://host.docker.internal:9925
MEALIE_API_TOKEN=
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=production
SQUARE_LOCATION_ID=
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
# Leave empty if Paperless and Mealie already run on Unraid.
# Add paperless and/or mealie only if you want this stack to create them.
COMPOSE_PROFILES=

# Talk to an existing Paperless container via the Unraid host.
PAPERLESS_BASE_URL=http://host.docker.internal:8011
PAPERLESS_API_TOKEN=

# Unraid Chromium price collector (login-once profiles).
COLLECTOR_VNC_URL=http://100.116.48.120:7900

# Optional local LLM for invoice line extraction later. Leave empty until you add Ollama.
OLLAMA_BASE_URL=
OLLAMA_TEXT_MODEL=
OLLAMA_VISION_MODEL=

# Marketing stack (compose.marketing.yml). Not started unless you run scripts/up-marketing.sh.
# setup.sh replaces every change-me value below. Do not commit the filled-in .env.
# Bind the dashboard, Mautic, and Postiz to Tailscale. 127.0.0.1 is the compose default.
# Do not set 0.0.0.0.
BIND_ADDR=100.116.48.120
COMMAND_HTTPS_ONLY=false
COMMAND_DB_PASSWORD=change-me
# Public HTTPS is a separate approval. Leave the hostnames empty until you have DNS.
PUBLIC_POSTIZ_HOST=
PUBLIC_MAUTIC_HOST=
ACME_EMAIL=
MAUTIC_TRUSTED_PROXIES=172.16.0.0/12
MAUTIC_PORT=8084
POSTIZ_PORT=4007
COMMAND_PORT=8090
TEMPORAL_UI_PORT=8085
MAUTIC_URL=http://100.116.48.120:8084
POSTIZ_URL=http://100.116.48.120:4007
COMMAND_URL=http://100.116.48.120:8090
COMMAND_ADMIN_EMAIL=surveycafedowntown@gmail.com
COMMAND_ADMIN_PASSWORD=change-me
COMMAND_SECRET_KEY=change-me
MAUTIC_DB_ROOT_PASSWORD=change-me
MAUTIC_DB_PASSWORD=change-me
POSTIZ_DB_PASSWORD=change-me
POSTIZ_JWT_SECRET=change-me
TEMPORAL_DB_PASSWORD=change-me
POSTIZ_DISABLE_REGISTRATION=false
# Meta and TikTok developer apps for Postiz. Leave blank until the apps exist.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
