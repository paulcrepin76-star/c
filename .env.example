# Copy to .env and adjust. Never put live supplier passwords in git.
# On Unraid, keep this file next to compose.yml in /mnt/user/appdata/resto/
# Deploy from a LAN laptop: ./scripts/deploy-unraid.sh root@YOUR_UNRAID_IP

TZ=America/New_York
PUID=99
PGID=100

# Host path for all container config/data (Unraid default below).
APPDATA=/mnt/user/appdata/resto
# Drop folder for PDFs you download yourself. Paperless watches this.
CONSUME_DIR=/mnt/user/documents/invoices-inbox

POSTGRES_USER=resto
POSTGRES_PASSWORD=change-me-now
POSTGRES_DB=resto

# Used by resto-core sessions + n8n. Generate with: openssl rand -hex 32
SECRET_KEY=change-me-generate-a-long-random-string
N8N_ENCRYPTION_KEY=change-me-generate-a-long-random-string
PAPERLESS_SECRET_KEY=change-me-generate-a-long-random-string

# Public URLs if you put the stack behind Nginx Proxy Manager / Caddy.
# Leave as LAN URLs if you only access it on your home network.
RESTO_URL=http://192.168.1.10:8088
PAPERLESS_URL=http://192.168.1.10:8010
MEALIE_URL=http://192.168.1.10:9925
N8N_URL=http://192.168.1.10:5678
METABASE_URL=http://192.168.1.10:3001

# Optional: resto-core talks to these if set. Credentials stay here or in n8n, never in code.
RESTO_API_KEY=change-me-api-key
MEALIE_BASE_URL=http://mealie:9000
MEALIE_API_TOKEN=
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=production
SQUARE_LOCATION_ID=
PAPERLESS_BASE_URL=http://paperless:8000
PAPERLESS_API_TOKEN=

# Optional local LLM for invoice line extraction later. Leave empty until you add Ollama.
OLLAMA_BASE_URL=
