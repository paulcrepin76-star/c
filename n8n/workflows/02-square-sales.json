{
  "name": "Square sales → cellar",
  "active": false,
  "settings": { "executionOrder": "v1" },
  "nodes": [
    {
      "id": "s0",
      "name": "Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [0, 220],
      "parameters": {
        "width": 480,
        "height": 200,
        "content": "## You do not add credentials here\nConnect Square, Mealie and Paperless on the cellar site:\nhttp://100.116.48.120:8088/connect\n\nThis workflow only rings the bell at 02:10. resto-core already has the logins."
      }
    },
    {
      "id": "s1",
      "name": "Every night 02:10",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": {
        "rule": {
          "interval": [
            { "field": "days", "daysInterval": 1, "triggerAtHour": 2, "triggerAtMinute": 10 }
          ]
        }
      }
    },
    {
      "id": "s2",
      "name": "Test now",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 100],
      "parameters": {}
    },
    {
      "id": "s3",
      "name": "Sync Square Mealie Paperless",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [280, 40],
      "parameters": {
        "method": "POST",
        "url": "http://resto-core:8080/api/jobs/sync-all",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-API-Key", "value": "={{ $env.RESTO_API_KEY }}" }
          ]
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "Every night 02:10": {
      "main": [[{ "node": "Sync Square Mealie Paperless", "type": "main", "index": 0 }]]
    },
    "Test now": {
      "main": [[{ "node": "Sync Square Mealie Paperless", "type": "main", "index": 0 }]]
    }
  }
}
