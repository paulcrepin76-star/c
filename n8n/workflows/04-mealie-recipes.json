{
  "name": "Mealie recipes → cellar",
  "active": false,
  "settings": { "executionOrder": "v1" },
  "nodes": [
    {
      "id": "m0",
      "name": "Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [0, 200],
      "parameters": {
        "width": 460,
        "height": 180,
        "content": "## Credentials live on the cellar site\nhttp://100.116.48.120:8088/connect\n\nThis extra timer is optional. The nightly Square workflow already syncs Mealie."
      }
    },
    {
      "id": "m1",
      "name": "Every morning 05:30",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": {
        "rule": {
          "interval": [
            { "field": "days", "daysInterval": 1, "triggerAtHour": 5, "triggerAtMinute": 30 }
          ]
        }
      }
    },
    {
      "id": "m2",
      "name": "Test now",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 100],
      "parameters": {}
    },
    {
      "id": "m3",
      "name": "Sync all",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [280, 40],
      "parameters": {
        "method": "POST",
        "url": "http://resto-core:8080/api/jobs/sync-all",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-API-Key", "value": "={{ $env.RESTO_API_KEY }}" }
          ]
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "Every morning 05:30": {
      "main": [[{ "node": "Sync all", "type": "main", "index": 0 }]]
    },
    "Test now": {
      "main": [[{ "node": "Sync all", "type": "main", "index": 0 }]]
    }
  }
}
