{
  "name": "Paperless invoices → cellar",
  "active": false,
  "settings": { "executionOrder": "v1" },
  "nodes": [
    {
      "id": "p0",
      "name": "Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [0, 200],
      "parameters": {
        "width": 460,
        "height": 200,
        "content": "## Backup timer, not the main path\nPaperless already pings the cellar when a new invoice lands.\nThis 15-minute pass catches OCR amounts and anything the webhook missed.\nLogins live at http://100.116.48.120:8088/connect"
      }
    },
    {
      "id": "p1",
      "name": "Every 15 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": {
        "rule": {
          "interval": [{ "field": "minutes", "minutesInterval": 15 }]
        }
      }
    },
    {
      "id": "p2",
      "name": "Test now",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 100],
      "parameters": {}
    },
    {
      "id": "p3",
      "name": "Sync new Paperless invoices",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [280, 40],
      "parameters": {
        "method": "POST",
        "url": "http://resto-core:8080/api/jobs/sync-paperless",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-API-Key", "value": "={{ $env.RESTO_API_KEY }}" }
          ]
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "Every 15 minutes": {
      "main": [[{ "node": "Sync new Paperless invoices", "type": "main", "index": 0 }]]
    },
    "Test now": {
      "main": [[{ "node": "Sync new Paperless invoices", "type": "main", "index": 0 }]]
    }
  }
}
