{
  "manifest_version": 3,
  "name": "Restaurant Price Collector",
  "version": "0.3.0",
  "description": "Send the current supplier page to the Survey Cafe cellar. Prefers the site JSON. Does not crawl Sam's or n8n.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "http://100.116.48.120:8088/*",
    "http://127.0.0.1:8088/*",
    "http://localhost:8088/*"
  ],
  "action": {
    "default_title": "Send visible prices",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.samsclub.com/*",
        "https://www.costco.com/*",
        "https://www.walmart.com/*",
        "https://www.publix.com/*",
        "https://www.target.com/*",
        "https://www.aldi.us/*",
        "https://www.chefswarehouse.com/*",
        "https://shop.chefswarehouse.com/*",
        "https://order.gfs.com/*",
        "https://www.restaurantdepot.com/*",
        "https://shop.sysco.com/*",
        "https://www.webstaurantstore.com/*"
      ],
      "js": ["hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.samsclub.com/*",
        "https://www.costco.com/*",
        "https://www.walmart.com/*",
        "https://www.publix.com/*",
        "https://www.target.com/*",
        "https://www.aldi.us/*",
        "https://www.chefswarehouse.com/*",
        "https://shop.chefswarehouse.com/*",
        "https://order.gfs.com/*",
        "https://www.restaurantdepot.com/*",
        "https://shop.sysco.com/*",
        "https://www.webstaurantstore.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
